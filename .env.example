# Copy to .env.local (never committed). Values from the Supabase dashboard → Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…      # "Publishable key" (safe in the browser; RLS applies)
SUPABASE_SECRET_KEY=sb_secret_…                           # "Secret key" — server only: admin routes, workers. Bypasses RLS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # on Vercel: leave unset, the production URL is used automatically

# Founder-only surfaces. Leave empty on any environment a tester can reach.
INTERNAL_API_TOKEN=                                       # long random string; the cross-venture overview sends it as a Bearer token
MY_VENTURES_URL=                                          # the founder overview page; only rendered for superadmins

# Feedback board (core). Server only. Without it the board still works: titles are the person's own first line.
ANTHROPIC_API_KEY=                                        # Claude API key; reformats feedback with Claude Haiku 5.5 (core/src/lib/feedback-format.ts)
